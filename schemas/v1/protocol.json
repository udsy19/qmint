      "type": "array"
    },
    "protocol_id": {
      "title": "Protocol Id",
      "type": "string"
    },
    "protocol_revision": {
      "minLength": 1,
      "title": "Protocol Revision",
      "type": "string"
    },
    "quantum_memory_required": {
      "title": "Quantum Memory Required",
      "type": "boolean"
    },
    "quantum_stage": {
      "minLength": 1,
      "title": "Quantum Stage",
      "type": "string"
    },
    "redemption_semantics": {
