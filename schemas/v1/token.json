{
  "$defs": {
    "StateKind": {
      "enum": [
        "physical_quantum",
        "ideal_simulated",
        "noisy_simulated",
        "symbolic_record",
        "measured_classical_transcript"
      ],
      "title": "StateKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Public, wallet-side token record. MUST NOT contain bases, bits or verifier secrets.",
  "properties": {
    "backend_provenance": {
      "minLength": 1,
      "title": "Backend Provenance",
      "type": "string"
    },
    "commitment_time_utc_ns": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commitment Time Utc Ns"
    },
    "freshness": {
      "default": "fresh",
      "enum": [
        "fresh",
        "spent",
        "verified_reminted",
        "unknown"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "issue_event_id": {
      "minLength": 1,
      "title": "Issue Event Id",
      "type": "string"
    },
    "n_prepared": {
      "minimum": 1,
      "title": "N Prepared",
      "type": "integer"
    },
    "ownership_context": {
      "minLength": 1,
      "title": "Ownership Context",
      "type": "string"
    },
    "protocol_id": {
      "title": "Protocol Id",
      "type": "string"
    },
    "public_metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Public Metadata",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_state_family": {
      "minLength": 1,
      "title": "Source State Family",
      "type": "string"
    },
    "state_kind": {
      "$ref": "#/$defs/StateKind"
    },
    "token_id": {
      "minLength": 1,
      "title": "Token Id",
      "type": "string"
    }
  },
  "required": [
    "token_id",
    "protocol_id",
    "n_prepared",
    "source_state_family",
    "issue_event_id",
    "state_kind",
    "ownership_context",
    "backend_provenance"
  ],
  "title": "TokenRecord",
  "type": "object"
}
