 "theorem": {
  "assumptions": [
   "Bank note = n qubits, each uniformly and independently one of |0>,|1>,|+>,|-> (secret to the adversary).",
   "Adversary receives exactly ONE valid note and applies any quantum channel to output two notes (simple counterfeiting).",
   "No access to a verification oracle; no repeated or adaptive verification; no leaked post-measurement states (MVW2012 p.2 explicitly excludes these).",
   "Bank verifies each candidate independently with the exact projective test (all n qubits must be correct; zero error tolerance, no loss)."
  ],
  "axes": [
   {
    "anchor": "MVW2012 Theorem 1",
    "axis": "epsilon_unf",
    "bound_id": "P-W1/unf",
    "domain": "n integer >= 1",
    "domain_only": [],
    "formula": "(3/4)^n",
    "monotonicity": {}
   }
  ],
  "calibration_families": [],
  "caveats": [
   "Not a bound for noisy/threshold verifiers (that is game W2), lossy channels, oracle access, or S-money.",
   "Does not cover the classical-verification variant (P-W1CV) and must not be used for it."
  ],
  "citation": "A. Molina, T. Vidick, J. Watrous. Optimal counterfeiting attacks and generalizations for Wiesner's quantum money. TQC 2012, LNCS 7582, 45-64. arXiv:1202.4010v1",
  "claim_id": "P-W1",
  "finite_or_asymptotic": "exact for every finite n >= 1",
  "game": "W1",
  "parameters": {
   "n": "number of qubits per note, integer >= 1"
  },
  "protocol": "wiesner_ideal",
  "quantifier": "sup over ALL quantum channels (CPTP maps, unbounded ancilla and computation) from one note to two notes",
  "statement": "MVW2012 Theorem 1 (p.2): optimal simple counterfeiting attack on Wiesner's scheme succeeds with probability exactly (3/4)^n.",
  "status": "PUBLISHED_REPRODUCED",
  "url": "https://arxiv.org/abs/1202.4010"
 }
